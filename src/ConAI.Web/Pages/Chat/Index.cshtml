@page
@using System.Globalization
@using ConAI.Web.Services
@model ConAI.Web.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "議事録を探す";
}

<h1 class="page-title">議事録を探す</h1>

<div id="conai-chat" class="card mt-6" data-chat-url="/api/chat" data-search-url="/api/search">
    <div class="mt-4">
        <label class="form-label" for="chat-input">質問またはキーワード</label>
        <textarea id="chat-input" class="input-field mt-1" rows="3"
                  maxlength="@ChatLimits.MaxQuestionChars"></textarea>
        <p class="form-help">
            会議名、議事録、文字起こしから探します。Ctrl+Enter でも探せます。@ChatLimits.MaxQuestionChars.ToString("N0", CultureInfo.InvariantCulture) 文字までです。
        </p>
    </div>

    <div class="mt-4 flex flex-wrap gap-3">
        <button id="chat-send" type="button" class="btn-primary">探す</button>
    </div>

    <p id="chat-busy" class="mt-4 hidden text-sm"></p>
    <div id="chat-notice" class="alert-note mt-4 hidden"></div>
    <div id="chat-error" class="alert-destructive mt-4 hidden" role="alert"></div>

    <section id="search-panel" class="mt-6 hidden" aria-labelledby="search-heading">
        <h2 id="search-heading" class="section-title">検索結果</h2>
        <p id="search-summary" class="mt-1 text-sm"></p>
        <ul id="search-results" class="mt-3 space-y-3" aria-live="polite" aria-busy="false"></ul>
        <div class="mt-4 flex flex-wrap gap-3">
            <button id="search-more" type="button" class="btn-secondary hidden">さらに表示</button>
            <button id="search-answer" type="button" class="btn-primary hidden">回答を作る</button>
        </div>
    </section>

    <section class="mt-6" aria-labelledby="chat-heading">
        <h2 id="chat-heading" class="section-title">会話</h2>
        <div id="chat-turns" class="max-h-[32rem] space-y-4 overflow-y-auto pr-2"
             aria-live="polite" aria-busy="false">
            @foreach (var turn in Model.Turns)
            {
                <div class="border-l-2 border-border pl-4" data-turn-id="@turn.Id">
                    <p class="text-sm text-muted-foreground">@turn.CreatedAtText</p>
                    <p class="mt-1 font-medium">@turn.Question</p>
                    <div class="conai-prose mt-2">@Html.Raw(turn.AnswerHtml)</div>
                    @if (turn.Sources.Count > 0)
                    {
                        <p class="mt-2 text-sm text-muted-foreground">
                            根拠:
                            @{ var firstSource = true; }
                            @foreach (var source in turn.Sources)
                            {
                                @if (!firstSource)
                                {
                                    <span>、</span>
                                }
                                firstSource = false;
                                @if (source.MeetingId is { } meetingId)
                                {
                                    <a class="btn-link" asp-page="/Meetings/Details" asp-route-id="@meetingId">@source.Title</a>
                                }
                                else
                                {
                                    <span>@source.Title</span>
                                }
                            }
                        </p>
                    }
                </div>
            }
        </div>

        <p id="chat-empty" class="mt-4 text-muted-foreground @(Model.Turns.Count == 0 ? "" : "hidden")">
            まだ会話はありません。検索してから『回答を作る』を押すと、ここに答えが並びます。
        </p>

        <div class="mt-4 flex flex-wrap gap-3">
            <button id="chat-clear" type="button" class="btn-destructive">会話を消す</button>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/chat.js" type="module" asp-append-version="true"></script>
}
