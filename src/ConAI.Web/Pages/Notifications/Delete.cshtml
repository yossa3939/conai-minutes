@page "{id:guid}"
@using ConAI.Web.Notifications
@model ConAI.Web.Pages.Notifications.DeleteModel
@{
    ViewData["Title"] = "宛先を削除";
}

<h1 class="page-title text-destructive">宛先を削除</h1>

<p class="mt-4">次の宛先を削除します。この操作は元に戻せません。</p>

<div class="card mt-6 max-w-3xl">
    <dl class="grid grid-cols-1 gap-y-3 sm:grid-cols-[8rem_1fr] sm:gap-x-4">
        <dt class="font-medium">名前</dt>
        <dd>@Model.Endpoint.Name</dd>
        <dt class="font-medium">種別</dt>
        <dd>@WebhookKinds.DisplayName(Model.Endpoint.Kind)</dd>
        <dt class="font-medium">宛先</dt>
        <dd class="font-mono text-sm">@Model.Endpoint.UrlHint</dd>
    </dl>
</div>

<form method="post" class="mt-6 flex flex-wrap gap-3">
    <button type="submit" class="btn-destructive">削除する</button>
    <a class="btn-secondary" asp-page="./Index">戻る</a>
</form>
