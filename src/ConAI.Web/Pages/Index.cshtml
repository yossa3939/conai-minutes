@page
@model ConAI.Web.Pages.IndexModel
@{
    ViewData["Title"] = AppInfo.Name;
}

<div class="card mx-auto max-w-xl text-center">
    <h1 class="page-title">@AppInfo.Name</h1>
    <p class="mt-4">会議の音声から文字起こしと議事録を作ります。</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a class="btn-primary" asp-area="Identity" asp-page="/Account/Login">ログイン</a>
    </div>
</div>
