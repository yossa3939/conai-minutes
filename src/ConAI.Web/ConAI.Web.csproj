<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-ConAI.Web-60c20486-a9dc-4337-b0c3-74dc909bdd6c</UserSecretsId>
    <!-- node_modules を SDK の既定グロブから外す。外すと数万ファイルの走査が消える -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Google.GenAI" Version="1.18.0" />
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="LibNMeCab.IpaDicBin" Version="0.10.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Prompts\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tailwind CSS の入力。ここが変わったときだけ CSS を作り直す -->
  <ItemGroup>
    <TailwindInput Include="Styles\app.css" />
    <TailwindInput Include="package.json" />
    <TailwindInput Include="package-lock.json" />
    <TailwindInput Include="Pages\**\*.cshtml" />
    <TailwindInput Include="Areas\**\*.cshtml" />
    <TailwindInput Include="Areas\**\*.cs" />
    <TailwindInput Include="wwwroot\js\**\*.js" />
  </ItemGroup>

  <Target Name="BuildTailwindCss"
          BeforeTargets="Build;ResolveStaticWebAssetsInputs"
          Inputs="@(TailwindInput)"
          Outputs="wwwroot\css\app.css">

    <Exec Command="npm --version"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ConAINpmExitCode" />
    </Exec>

    <Error Condition="'$(ConAINpmExitCode)' != '0'"
           Text="npm が見つかりません。ConAI のビルドには Node.js 20 以上が必要です。README の「すぐ動かす」を参照してください。" />

    <Exec Command="npm ci"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="!Exists('$(MSBuildProjectDirectory)\node_modules')" />

    <Exec Command="npx @tailwindcss/cli -i Styles/app.css -o wwwroot/css/app.css --minify"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <ItemGroup>
      <Content Remove="wwwroot\css\app.css" />
      <Content Include="wwwroot\css\app.css" />
    </ItemGroup>
  </Target>

</Project>
