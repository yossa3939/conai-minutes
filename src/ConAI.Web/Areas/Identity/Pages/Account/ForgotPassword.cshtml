@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "パスワードの再設定";
}

<h1 class="page-title">パスワードの再設定</h1>

@if (Model.IsMailConfigured)
{
    <div class="card mt-6 max-w-md">
        <p>登録しているメールアドレスを入力してください。</p>
        <form method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="input-field" autocomplete="username" aria-required="true" aria-describedby="Input_Email-error" />
                <span asp-validation-for="Input.Email" id="Input_Email-error"></span>
            </div>
            <button type="submit" class="btn-primary w-full">再設定のメールを送る</button>
        </form>
    </div>
}
else
{
    <div class="alert-note mt-6 max-w-md">
        この環境ではメールでの再設定が設定されていません。管理者に連絡してください。
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
