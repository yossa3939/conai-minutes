@page
@model SetPasswordModel

@{
    ViewData["Title"] = "パスワードの設定";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="section-title">パスワードの設定</h2>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card mt-4 max-w-md">
    <p>このアカウントにはパスワードが設定されていません。設定すると、メールアドレスとパスワードでもログインできるようになります。</p>
    <form id="set-password-form" method="post" class="mt-4">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="mb-4">
            <label asp-for="Input.NewPassword" class="form-label"></label>
            <input asp-for="Input.NewPassword" class="input-field" autocomplete="new-password" aria-required="true" aria-describedby="Input_NewPassword-error" />
            <span asp-validation-for="Input.NewPassword" id="Input_NewPassword-error"></span>
            <p class="form-help">6 文字以上で、大文字、小文字、数字、記号をそれぞれ 1 つ以上含めてください。</p>
        </div>
        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="input-field" autocomplete="new-password" aria-required="true" aria-describedby="Input_ConfirmPassword-error" />
            <span asp-validation-for="Input.ConfirmPassword" id="Input_ConfirmPassword-error"></span>
        </div>
        <button type="submit" class="btn-primary w-full">パスワードを設定</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
